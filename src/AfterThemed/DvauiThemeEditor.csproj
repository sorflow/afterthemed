<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DVAUI Theme Editor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AfterThemed-AppIcon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\AfterThemed-Mark.svg" />
    <EmbeddedResource Include="Assets\AfterThemed-Mark.svg" LogicalName="DvauiThemeEditor.Assets.AfterThemed-Mark.svg" />
    <None Include="..\..\EULA.txt" Link="EULA.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AfterThemed.RegressionTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <Target Name="BuildWebUi" BeforeTargets="PrepareForBuild" Condition="Exists('web\package.json')">
    <Exec Command="npm ci" WorkingDirectory="web" Condition="!Exists('web\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="web" />
  </Target>

  <Target Name="CopyWebUiToOutput" AfterTargets="Build" Condition="Exists('web\dist\index.html')">
    <ItemGroup>
      <WebUiAsset Include="web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiAsset)" DestinationFiles="@(WebUiAsset->'$(TargetDir)WebUi\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWebUiToPublish" AfterTargets="Publish" Condition="Exists('web\dist\index.html')">
    <ItemGroup>
      <WebUiPublishAsset Include="web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiPublishAsset)" DestinationFiles="@(WebUiPublishAsset->'$(PublishDir)WebUi\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
